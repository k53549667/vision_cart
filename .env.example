# VisionKart Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_USER=your_database_user
DB_PASS=your_secure_password
DB_NAME=snoptical

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/snoptical
APP_NAME=VisionKart

# ===========================================
# SECURITY SETTINGS
# ===========================================
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET_KEY=your_32_character_secret_key_here
CSRF_SECRET=your_csrf_secret_key_here

# ===========================================
# PAYMENT GATEWAY KEYS (Server-side only!)
# ===========================================
# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Stripe (if used)
STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@visionkart.com
MAIL_FROM_NAME=VisionKart

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ===========================================
# RATE LIMITING
# ===========================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=60
